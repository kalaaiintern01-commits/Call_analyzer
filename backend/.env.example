# =============================================
# GENSET CALL ANALYZER - API KEYS
# =============================================
# Copy this file to .env and fill in your keys
#   cp .env.example .env
# =============================================

# ── Platform standardization (backend-standardizations §7) ──
# Defaults are dev-safe — leave APP_ENV unset locally; CI / WinSW set
# APP_ENV=production to flip on the standard error envelope + JWT enforcement
# when that lands.
APP_ENV=dev
SERVICE_NAME=call-center
GIT_SHA=dev
LOG_LEVEL=INFO
PORT=8006
HOST=0.0.0.0

# Sarvam AI — for Marathi speech-to-text
# Sign up at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenRouter — for LLM summarization (uses free Gemini model)
# Sign up at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# =============================================
# PLIVO — for auto-processing recorded calls
# =============================================
# Sign up at: https://console.plivo.com
# Auth ID + Auth Token from the Plivo dashboard home page
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here

# Public base URL of THIS backend — Plivo must be able to reach it.
# For local dev, expose port 8006 with ngrok and paste the https URL here:
#   ngrok http 8006
# Example: https://abcd-1234.ngrok-free.app
SERVER_BASE_URL=http://localhost:8006

# Language to transcribe Plivo-recorded calls in (Sarvam code, e.g. mr-IN, hi-IN, en-IN)
PLIVO_CALL_LANGUAGE=mr-IN

# Agent mapping — which salesperson(s) to forward each inbound DID to.
# Format: <plivo_did>:<num1>[|num2|...]:<name1>[|name2|...]
# Multiple DIDs separated by commas. Multiple agents per DID separated by `|`
# (they ring in parallel — first to pick up wins).
# Example: AGENT_MAPPING=+918035303414:+919111111111|+919222222222:Varun|Arpita
AGENT_MAPPING=+91XXXXXXXXXX:+91YYYYYYYYYY:AgentName

# =============================================
# ERP SQL Server — read leads + write AICallSummary (backend/erp.py)
# =============================================
# Both /api/erp/* and /api/agent/leads endpoints fail with 503 if these are
# missing. Two databases on the same SQL Server, same login:
#   ERPAI            → read-only access to dbo.Enquiry
#   call_analyzer    → read+write on dbo.AICallSummary
#
# ERP_SQL_DRIVER must match a row in `Get-OdbcDriver` EXACTLY (no aliasing).
# Production hosts ship "ODBC Driver 17 for SQL Server"; if you're on 18 (newer
# Microsoft download), set that instead. Check with:
#   PowerShell> Get-OdbcDriver | Select Name
ERP_SQL_SERVER=<host-or-ip>
ERP_SQL_DATABASE=ERPAI
ERP_SUMMARY_DATABASE=call_analyzer
ERP_SQL_USERNAME=<sql-login-username>
ERP_SQL_PASSWORD=<sql-login-password>
ERP_SQL_DRIVER=ODBC Driver 17 for SQL Server
